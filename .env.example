# ==========================================
# INDUSTRIAL BRAIN OS - ENVIRONMENT TEMPLATE
# ==========================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-with-a-secure-secret-key-32-chars-long
LOG_LEVEL=INFO

# Backend API Service
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ==========================================
# INFRASTRUCTURE DATABASES & SERVICES
# ==========================================

# 1. PostgreSQL (Relational & Core Metadata)
POSTGRES_DB=industrial_brain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 2. Neo4j Community (Knowledge Graph)
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_HOST=localhost
NEO4J_PORT=7474
NEO4J_BOLT_PORT=7687

# 3. Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 4. Redis (Cache, Session & Message Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# 5. MinIO (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=industrial-brain-documents
